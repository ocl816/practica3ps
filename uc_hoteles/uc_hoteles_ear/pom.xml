<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>es.unican.ps</groupId>
		<artifactId>uc_hoteles</artifactId>
		<version>1.0-SNAPSHOT</version>
	</parent>

	<artifactId>uc_hoteles_ear</artifactId>
	<packaging>ear</packaging>

	<dependencies>
		<!-- Capa de negocio -->
		<dependency>
			<groupId>es.unican.ps</groupId>
			<artifactId>uc_hoteles_business</artifactId>
			<version>1.0-SNAPSHOT</version>
			<type>ejb</type>
		</dependency>
		<!-- Capa DAO-->
		<dependency>
			<groupId>es.unican.ps</groupId>
			<artifactId>uc_hoteles_dao</artifactId>
			<version>1.0-SNAPSHOT</version>
			<type>ejb</type>
		</dependency>
		<!-- Libreria comun -->
		<dependency>
			<groupId>es.unican.ps</groupId>
			<artifactId>uc_hoteles_common</artifactId>
			<version>1.0-SNAPSHOT</version>
		</dependency>
		<!-- Capa web -->
		<dependency>
    		<groupId>es.unican.ps</groupId>
    		<artifactId>uc_hoteles_web</artifactId>
    		<version>1.0-SNAPSHOT</version>
    		<type>war</type>
		</dependency>
	</dependencies>

	<build>
		<finalName>UCHoteles</finalName>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-ear-plugin</artifactId>
				<version>3.3.0</version>
				<configuration>
					<version>10</version>
					<defaultLibBundleDir>lib</defaultLibBundleDir>
					<modules>
						<ejbModule>
							<groupId>es.unican.ps</groupId>
							<artifactId>uc_hoteles_business</artifactId>
							<bundleFileName>UCHotelesBusiness.jar</bundleFileName>
						</ejbModule>
						<ejbModule>
							<groupId>es.unican.ps</groupId>
							<artifactId>uc_hoteles_dao</artifactId>
							<bundleFileName>UCHotelesDAO.jar</bundleFileName>
						</ejbModule>
						<jarModule>
							<groupId>es.unican.ps</groupId>
							<artifactId>uc_hoteles_common</artifactId>
							<bundleFileName>UCHotelesCommon.jar</bundleFileName>
						</jarModule>
						<webModule>
    						<groupId>es.unican.ps</groupId>
    						<artifactId>uc_hoteles_web</artifactId>
    						<bundleFileName>UCHotelesWeb.war</bundleFileName>
    						<contextRoot>/UCHoteles</contextRoot>
						</webModule>
					</modules>
				</configuration>
			</plugin>

			<!-- Plugin para desplegar el ear desde Maven -->
			<plugin>
				<groupId>org.glassfish.maven.plugin</groupId>
				<artifactId>maven-glassfish-plugin</artifactId>
				<version>2.1</version>
				<configuration>
					<glassfishDirectory>${local.glassfish.home}</glassfishDirectory>
					<user>admin</user>
					<passwordFile>${local.glassfish.passfile}</passwordFile>
					<domain>
						<name>domain1</name>
						<httpPort>8080</httpPort>
						<adminPort>4848</adminPort>
					</domain>
					<components>
						<component>
							<name>${project.artifactId}</name>
							<artifact>target/${project.build.finalName}.ear</artifact>
						</component>
					</components>
					<echo>true</echo>
				</configuration>
			</plugin>

		</plugins>
	</build>

</project>